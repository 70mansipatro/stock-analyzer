# Copy to .env.local and fill in. Never commit .env.local.

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console > Google Auth Platform > Clients)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

# Postgres
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stockapp?schema=public"

# Vertex AI. Credentials: paste a service-account JSON key (role "Vertex AI User") on ONE line,
# or leave empty to use `gcloud auth application-default login`.
GOOGLE_VERTEX_CREDENTIALS=''
GOOGLE_VERTEX_PROJECT=""
GOOGLE_VERTEX_LOCATION="global"
CHAT_MODEL="gemini-3.5-flash"
CHAT_FALLBACK_MODEL="gemini-2.5-flash"
GUARDRAIL_MODEL="gemini-2.5-flash-lite"

# Signs chatbot trade approvals: generate with `openssl rand -base64 32`
TOOL_APPROVAL_SECRET=""

# Comma-separated emails that are always Admin (bootstraps the first admin)
ADMIN_EMAILS=""

# Email (optional). Gmail: turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and paste it below. Empty = emails are recorded but not sent
# (sign-in codes are then printed in the dev server console).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Stock Analyzer <you@gmail.com>"
APP_URL="http://localhost:3000"

# Optional: YouTube Data API key for "show me videos" in the AI chat. Empty = falls back to YouTube's public search page.
YOUTUBE_API_KEY=""

# Optional: lets an external scheduler call GET /api/alerts/check with "Authorization: Bearer <secret>".
# Alerts are also checked every minute by the app server itself.
CRON_SECRET=""

# Optional: Auto-Trader message channel. Any incoming-webhook URL (Slack, Discord, Teams, a bot...) gets a
# JSON POST {"text": ..., "content": ...} for every automatic trade and Auto-Trader event, for every user,
# so use it on single-user or team installs. Empty = in-app and email only.
NOTIFY_WEBHOOK_URL=""

# Optional: extra exchange holidays (comma-separated YYYY-MM-DD) on top of the built-in NYSE and NSE lists,
# e.g. when a new year's holiday calendar is published.
MARKET_HOLIDAYS_US=""
MARKET_HOLIDAYS_IN=""
