# Copy to .env.local and fill in. Never commit .env.local.

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=""
# Google OAuth client (Google Cloud Console > Google Auth Platform > Clients)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_URL="http://localhost:3000"

# Postgres
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stockapp?schema=public"

# Vertex AI. Credentials: paste a service-account JSON key (role "Vertex AI User") on ONE line,
# or leave empty to use `gcloud auth application-default login`.
GOOGLE_VERTEX_CREDENTIALS=''
GOOGLE_VERTEX_PROJECT=""
GOOGLE_VERTEX_LOCATION="global"
CHAT_MODEL="gemini-3.5-flash"
CHAT_FALLBACK_MODEL="gemini-2.5-flash"
GUARDRAIL_MODEL="gemini-2.5-flash-lite"

# Signs chatbot trade approvals: generate with `openssl rand -base64 32`
TOOL_APPROVAL_SECRET=""
