generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER = Trader (default). AUDITOR = read-only admin. VIEWER = can browse but not trade.
enum Role {
  USER
  ADMIN
  AUDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  lastLoginAt   DateTime?
  // Virtual paper-trading cash. No real money.
  cashBalance   Decimal   @default(100000) @db.Decimal(14, 2)
  // Cash the account started (or was last reset) with; returns are measured from this.
  startingCash  Decimal   @default(100000) @db.Decimal(14, 2)
  suspended     Boolean   @default(false)
  // Email preferences per category, e.g. {"orders": true, "account": true}. Missing = on.
  emailPrefs    Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  holdings  Holding[]
  agent     AgentConfig?
  trades    Trade[]
  auditLogs AuditLog[]
  alerts        PriceAlert[]
  notifications Notification[]
}

// OAuth accounts linked to a user (e.g. their Google account).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Active login sessions; deleting a row signs that device out.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeSource {
  UI
  CHAT
  AGENT
}

// Current position per user and symbol (paper trading).
model Holding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  quantity  Int
  // Average price paid per share, used for profit/loss.
  avgCost   Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// Every executed paper trade.
model Trade {
  id        String      @id @default(cuid())
  userId    String
  symbol    String
  side      TradeSide
  quantity  Int
  price     Decimal     @db.Decimal(14, 4)
  total     Decimal     @db.Decimal(14, 2)
  // Realized profit/loss, set on SELL trades.
  realizedPnl Decimal?  @db.Decimal(14, 2)
  source    TradeSource
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, source, createdAt])
}

// Guardrail decisions and sensitive actions, for review in Prisma Studio.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  // e.g. input_blocked, output_filtered, trade_denied, trade_executed, rate_limited
  event     String
  detail    Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
}

// Role given to an email by an admin, applied when that person signs in (or immediately if they already have).
model RoleAssignment {
  id           String   @id @default(cuid())
  email        String   @unique
  role         Role
  assignedById String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Platform-wide settings, one row with id "global".
model AppSettings {
  id                String   @id @default("global")
  maxOrderValue     Decimal  @default(50000) @db.Decimal(14, 2)
  maxSharesPerOrder Int      @default(10000)
  startingCash      Decimal  @default(100000) @db.Decimal(14, 2)
  tradingEnabled    Boolean  @default(true)
  aiEnabled         Boolean  @default(true)
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Every email the app sends (or would send), for delivery, retries and the admin Emails tab.
model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  kind      String      // invitation, role_changed, account_suspended, account_restored, order_filled, ...
  subject   String
  html      String      @db.Text
  text      String      @db.Text
  status    EmailStatus @default(PENDING)
  error     String?
  // Provider receipt, e.g. Gmail's "250 2.0.0 OK" and the Message-ID, as proof of hand-off.
  messageId String?
  response  String?
  attempts  Int         @default(0)
  userId    String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([createdAt])
}

// Emails an admin removed from the platform; they can't sign in again until an admin allows them.
model BlockedEmail {
  email       String   @id
  name        String?
  reason      String?
  blockedById String?
  createdAt   DateTime @default(now())
}

// One-time sign-in codes sent by email. Only a hash of the code is stored.
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

enum AlertCondition {
  ABOVE
  BELOW
}

// "Tell me when AAPL goes above $250." Checked every minute; fires once, then turns off.
model PriceAlert {
  id             String         @id @default(cuid())
  userId         String
  symbol         String
  condition      AlertCondition
  // In the stock's own currency.
  targetPrice    Decimal        @db.Decimal(14, 4)
  currency       String         @default("USD")
  note           String?
  active         Boolean        @default(true)
  triggeredAt    DateTime?
  triggeredPrice Decimal?       @db.Decimal(14, 4)
  lastCheckedAt  DateTime?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, symbol])
  @@index([userId, createdAt])
}

// In-app notifications shown under the bell in the top bar.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // alert_triggered, ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AgentMode {
  FULL_AUTO // monitors the selected stocks and buys/sells by itself, no approval
  SUGGEST   // proposes trades for the user to approve
  DRY_RUN   // only records what it would do
}

enum AgentRisk {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

// Settings for the AI auto-trader, one per user. Virtual money only.
model AgentConfig {
  userId              String    @id
  enabled             Boolean   @default(false)
  mode                AgentMode @default(FULL_AUTO)
  risk                AgentRisk @default(BALANCED)
  // USD the agent may keep invested at once.
  budget              Decimal   @default(5000) @db.Decimal(14, 2)
  maxPositionPct      Int       @default(15)   // max % of budget in one stock
  maxTradesPerDay     Int       @default(10)
  // Maximum loss: sell if a position falls this far below its buy price.
  stopLossPct         Decimal   @default(15)   @db.Decimal(5, 2)
  // Profit target: sell if a position rises this far above its buy price (0 = off).
  takeProfitPct       Decimal   @default(15)   @db.Decimal(5, 2)
  // Trailing stop: sell if the price falls this far below its highest price since the buy.
  trailingStopEnabled Boolean   @default(false)
  trailingStopPct     Decimal   @default(10)   @db.Decimal(5, 2)
  // The user's selected stocks (US tickers, or Indian with .NS / .BO).
  universe            String[]
  useAiReview         Boolean   @default(true)
  // Only trade a stock while its own exchange is open (NYSE/Nasdaq or NSE/BSE).
  marketHoursOnly     Boolean   @default(true)
  dailyEmail          Boolean   @default(true)
  // Hour of the day (server time, 0-23) after which the daily summary email goes out.
  summaryHour         Int       @default(20)
  // Email after every automatic buy and sell.
  tradeEmails         Boolean   @default(true)
  // Demo: runs every minute and ignores market hours.
  demoSpeed           Boolean   @default(false)
  lastRunAt           DateTime?
  // Lock: set while a run is in progress (shared by the scheduler and manual runs).
  runningSince        DateTime?
  lastSummaryDate     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions AgentPosition[]
}

// A position the agent opened, kept until it is sold. Tracks the highest price for the trailing stop.
// Quantity and cost come from the user's Holding and the agent's trades; this only adds what they can't.
model AgentPosition {
  id            String   @id @default(cuid())
  userId        String
  symbol        String
  // Highest price (USD) seen since the buy.
  highWaterUsd  Decimal  @db.Decimal(14, 4)
  buyTradeId    String?
  openedAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  config AgentConfig @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, symbol])
}

model AgentRun {
  id         String    @id @default(cuid())
  userId     String
  trigger    String    // scheduled | manual
  mode       AgentMode
  status     String    // running | completed | skipped | failed
  scanned    Int       @default(0)
  buyCount   Int       @default(0)
  sellCount  Int       @default(0)
  holdCount  Int       @default(0)
  errorCount Int       @default(0)
  summary    String?
  aiNote     String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  decisions AgentDecision[]

  @@index([userId, startedAt])
}

// One row per stock per run: what the agent decided, why, and what happened. Kept after a position closes.
model AgentDecision {
  id             String   @id @default(cuid())
  runId          String
  userId         String
  symbol         String
  market         String?  // US | IN
  action         String   // BUY | SELL | HOLD
  quantity       Int      @default(0)
  price          Decimal? @db.Decimal(14, 4) // stock's own currency
  priceUsd       Decimal? @db.Decimal(14, 4)
  score          Int      @default(0)        // -100..100
  confidence     Int      @default(0)        // 0..100
  reasons        Json
  // signal | stop_loss | take_profit | trailing_stop (sells), signal (buys)
  trigger        String?
  aiNote         String?
  // approved | vetoed | unavailable | off | not_reviewed | not_required
  aiStatus       String?
  // executing | executed | suggested | approved | rejected | dry_run | skipped | blocked | market_closed | failed | hold
  status         String
  error          String?
  tradeId        String?
  // Sells: average buy price (USD) and the realized result.
  entryPriceUsd  Decimal? @db.Decimal(14, 4)
  realizedPnl    Decimal? @db.Decimal(14, 2)
  realizedPnlPct Decimal? @db.Decimal(8, 2)
  // Risk settings in force when the decision was made.
  settings       Json?
  // Set while executing so the same signal can never be traded twice (cleared if the order fails).
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, action, createdAt])
  @@index([userId, symbol, createdAt])
  @@index([tradeId])
}
