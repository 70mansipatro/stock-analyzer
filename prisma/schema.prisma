generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  lastLoginAt   DateTime?
  // Virtual paper-trading cash. No real money.
  cashBalance   Decimal   @default(100000) @db.Decimal(14, 2)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  holdings  Holding[]
  trades    Trade[]
  auditLogs AuditLog[]
}

// OAuth accounts linked to a user (e.g. their Google account).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Active login sessions; deleting a row signs that device out.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeSource {
  UI
  CHAT
}

// Current position per user and symbol (paper trading).
model Holding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  quantity  Int
  // Average price paid per share, used for profit/loss.
  avgCost   Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// Every executed paper trade.
model Trade {
  id        String      @id @default(cuid())
  userId    String
  symbol    String
  side      TradeSide
  quantity  Int
  price     Decimal     @db.Decimal(14, 4)
  total     Decimal     @db.Decimal(14, 2)
  // Realized profit/loss, set on SELL trades.
  realizedPnl Decimal?  @db.Decimal(14, 2)
  source    TradeSource
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Guardrail decisions and sensitive actions, for review in Prisma Studio.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  // e.g. input_blocked, output_filtered, trade_denied, trade_executed, rate_limited
  event     String
  detail    Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
}
