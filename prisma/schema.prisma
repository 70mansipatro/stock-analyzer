generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER = Trader (default). AUDITOR = read-only admin. VIEWER = can browse but not trade.
enum Role {
  USER
  ADMIN
  AUDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  lastLoginAt   DateTime?
  // Virtual paper-trading cash. No real money.
  cashBalance   Decimal   @default(100000) @db.Decimal(14, 2)
  // Cash the account started (or was last reset) with; returns are measured from this.
  startingCash  Decimal   @default(100000) @db.Decimal(14, 2)
  suspended     Boolean   @default(false)
  // Email preferences per category, e.g. {"orders": true, "account": true}. Missing = on.
  emailPrefs    Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  holdings  Holding[]
  agent     AgentConfig?
  trades    Trade[]
  auditLogs AuditLog[]
  alerts        PriceAlert[]
  notifications Notification[]
}

// OAuth accounts linked to a user (e.g. their Google account).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Active login sessions; deleting a row signs that device out.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeSource {
  UI
  CHAT
  AGENT
}

// Current position per user and symbol (paper trading).
model Holding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  quantity  Int
  // Average price paid per share, used for profit/loss.
  avgCost   Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// Every executed paper trade.
model Trade {
  id        String      @id @default(cuid())
  userId    String
  symbol    String
  side      TradeSide
  quantity  Int
  price     Decimal     @db.Decimal(14, 4)
  total     Decimal     @db.Decimal(14, 2)
  // Realized profit/loss, set on SELL trades.
  realizedPnl Decimal?  @db.Decimal(14, 2)
  source    TradeSource
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Guardrail decisions and sensitive actions, for review in Prisma Studio.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  // e.g. input_blocked, output_filtered, trade_denied, trade_executed, rate_limited
  event     String
  detail    Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
}

// Role given to an email by an admin, applied when that person signs in (or immediately if they already have).
model RoleAssignment {
  id           String   @id @default(cuid())
  email        String   @unique
  role         Role
  assignedById String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Platform-wide settings, one row with id "global".
model AppSettings {
  id                String   @id @default("global")
  maxOrderValue     Decimal  @default(50000) @db.Decimal(14, 2)
  maxSharesPerOrder Int      @default(10000)
  startingCash      Decimal  @default(100000) @db.Decimal(14, 2)
  tradingEnabled    Boolean  @default(true)
  aiEnabled         Boolean  @default(true)
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Every email the app sends (or would send), for delivery, retries and the admin Emails tab.
model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  kind      String      // invitation, role_changed, account_suspended, account_restored, order_filled, ...
  subject   String
  html      String      @db.Text
  text      String      @db.Text
  status    EmailStatus @default(PENDING)
  error     String?
  // Provider receipt, e.g. Gmail's "250 2.0.0 OK" and the Message-ID, as proof of hand-off.
  messageId String?
  response  String?
  attempts  Int         @default(0)
  userId    String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([createdAt])
}

// Emails an admin removed from the platform; they can't sign in again until an admin allows them.
model BlockedEmail {
  email       String   @id
  name        String?
  reason      String?
  blockedById String?
  createdAt   DateTime @default(now())
}

// One-time sign-in codes sent by email. Only a hash of the code is stored.
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

enum AlertCondition {
  ABOVE
  BELOW
}

// "Tell me when AAPL goes above $250." Checked every minute; fires once, then turns off.
model PriceAlert {
  id             String         @id @default(cuid())
  userId         String
  symbol         String
  condition      AlertCondition
  // In the stock's own currency.
  targetPrice    Decimal        @db.Decimal(14, 4)
  currency       String         @default("USD")
  note           String?
  active         Boolean        @default(true)
  triggeredAt    DateTime?
  triggeredPrice Decimal?       @db.Decimal(14, 4)
  lastCheckedAt  DateTime?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active, symbol])
  @@index([userId, createdAt])
}

// In-app notifications shown under the bell in the top bar.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // alert_triggered, ...
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AgentMode {
  AUTO     // trades by itself
  SUGGEST  // proposes trades for the user to approve
  DRY_RUN  // only records what it would do
}

enum AgentRisk {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
}

// Settings for the AI auto-trader, one per user.
model AgentConfig {
  userId          String    @id
  enabled         Boolean   @default(false)
  mode            AgentMode @default(AUTO)
  risk            AgentRisk @default(BALANCED)
  // USD the agent may keep invested at once.
  budget          Decimal   @default(5000) @db.Decimal(14, 2)
  maxPositionPct  Int       @default(15)   // max % of budget in one stock
  maxTradesPerDay Int       @default(10)
  stopLossPct     Decimal   @default(8)    @db.Decimal(5, 2)
  takeProfitPct   Decimal   @default(15)   @db.Decimal(5, 2)
  universe        String[]
  useAiReview     Boolean   @default(true)
  dailyEmail      Boolean   @default(true)
  // Demo: runs every minute and ignores market hours.
  demoSpeed       Boolean   @default(false)
  lastRunAt       DateTime?
  // Lock: set while a run is in progress (shared by the scheduler and manual runs).
  runningSince    DateTime?
  lastSummaryDate String?
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgentRun {
  id         String    @id @default(cuid())
  userId     String
  trigger    String    // scheduled | manual
  mode       AgentMode
  status     String    // completed | skipped | failed
  scanned    Int       @default(0)
  summary    String?
  aiNote     String?   @db.Text
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  decisions AgentDecision[]

  @@index([userId, startedAt])
}

model AgentDecision {
  id         String   @id @default(cuid())
  runId      String
  userId     String
  symbol     String
  action     String   // BUY | SELL | HOLD
  quantity   Int      @default(0)
  price      Decimal? @db.Decimal(14, 4) // stock's own currency
  score      Int      @default(0)        // -100..100
  confidence Int      @default(0)        // 0..100
  reasons    Json
  aiNote     String?
  // executed | suggested | approved | rejected | dry_run | skipped | failed | hold
  status     String
  error      String?
  tradeId    String?
  createdAt  DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}
