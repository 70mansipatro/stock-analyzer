generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER = Trader (default). AUDITOR = read-only admin. VIEWER = can browse but not trade.
enum Role {
  USER
  ADMIN
  AUDITOR
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  lastLoginAt   DateTime?
  // Virtual paper-trading cash. No real money.
  cashBalance   Decimal   @default(100000) @db.Decimal(14, 2)
  // Cash the account started (or was last reset) with; returns are measured from this.
  startingCash  Decimal   @default(100000) @db.Decimal(14, 2)
  suspended     Boolean   @default(false)
  // Email preferences per category, e.g. {"orders": true, "account": true}. Missing = on.
  emailPrefs    Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  holdings  Holding[]
  trades    Trade[]
  auditLogs AuditLog[]
}

// OAuth accounts linked to a user (e.g. their Google account).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Active login sessions; deleting a row signs that device out.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

enum TradeSide {
  BUY
  SELL
}

enum TradeSource {
  UI
  CHAT
}

// Current position per user and symbol (paper trading).
model Holding {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  quantity  Int
  // Average price paid per share, used for profit/loss.
  avgCost   Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// Every executed paper trade.
model Trade {
  id        String      @id @default(cuid())
  userId    String
  symbol    String
  side      TradeSide
  quantity  Int
  price     Decimal     @db.Decimal(14, 4)
  total     Decimal     @db.Decimal(14, 2)
  // Realized profit/loss, set on SELL trades.
  realizedPnl Decimal?  @db.Decimal(14, 2)
  source    TradeSource
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Guardrail decisions and sensitive actions, for review in Prisma Studio.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  // e.g. input_blocked, output_filtered, trade_denied, trade_executed, rate_limited
  event     String
  detail    Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, createdAt])
}

// Role given to an email by an admin, applied when that person signs in (or immediately if they already have).
model RoleAssignment {
  id           String   @id @default(cuid())
  email        String   @unique
  role         Role
  assignedById String?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Platform-wide settings, one row with id "global".
model AppSettings {
  id                String   @id @default("global")
  maxOrderValue     Decimal  @default(50000) @db.Decimal(14, 2)
  maxSharesPerOrder Int      @default(10000)
  startingCash      Decimal  @default(100000) @db.Decimal(14, 2)
  tradingEnabled    Boolean  @default(true)
  aiEnabled         Boolean  @default(true)
  updatedById       String?
  updatedAt         DateTime @updatedAt
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

// Every email the app sends (or would send), for delivery, retries and the admin Emails tab.
model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  kind      String      // invitation, role_changed, account_suspended, account_restored, order_filled, ...
  subject   String
  html      String      @db.Text
  text      String      @db.Text
  status    EmailStatus @default(PENDING)
  error     String?
  attempts  Int         @default(0)
  userId    String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([createdAt])
}
